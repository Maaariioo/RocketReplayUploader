<Window x:Class="RocketReplayUploader.Views.GroupDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RocketReplayUploader.Infrastructure.Localization"
        Title="{Binding [Title.Group], Source={x:Static loc:TranslationSource.Instance}}"
        Style="{StaticResource AppWindowStyle}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/RocketReplayUploader;component/Assets/app.ico">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding [Group.DialogTitle], Source={x:Static loc:TranslationSource.Instance}}"
                   FontSize="20" FontFamily="{StaticResource ManropeSemiBold}" FontWeight="SemiBold"/>
        <TextBlock x:Name="TxtIntro" FontSize="12" Foreground="{DynamicResource BrushTextDim}"
                   Margin="0,4,0,18" TextWrapping="Wrap"/>

        <TextBlock Text="{Binding [Group.NameLabel], Source={x:Static loc:TranslationSource.Instance}}"
                   Margin="0,0,0,6"/>
        <TextBox x:Name="TxtName"
                 ToolTip="{Binding [Group.NameTip], Source={x:Static loc:TranslationSource.Instance}}"/>

        <TextBlock Text="{Binding [Group.PlayerLabel], Source={x:Static loc:TranslationSource.Instance}}"
                   Margin="0,16,0,6"/>
        <ComboBox x:Name="CboPlayerId" SelectedIndex="0"
                  ToolTip="{Binding [Group.PlayerTip], Source={x:Static loc:TranslationSource.Instance}}">
            <ComboBoxItem Content="{Binding [Group.PlayerById], Source={x:Static loc:TranslationSource.Instance}}"/>
            <ComboBoxItem Content="{Binding [Group.PlayerByName], Source={x:Static loc:TranslationSource.Instance}}"/>
        </ComboBox>

        <TextBlock Text="{Binding [Group.TeamLabel], Source={x:Static loc:TranslationSource.Instance}}"
                   Margin="0,16,0,6"/>
        <ComboBox x:Name="CboTeamId" SelectedIndex="0"
                  ToolTip="{Binding [Group.TeamTip], Source={x:Static loc:TranslationSource.Instance}}">
            <ComboBoxItem Content="{Binding [Group.TeamDistinct], Source={x:Static loc:TranslationSource.Instance}}"/>
            <ComboBoxItem Content="{Binding [Group.TeamClusters], Source={x:Static loc:TranslationSource.Instance}}"/>
        </ComboBox>
        <TextBlock Text="{Binding [Group.SettingsNote], Source={x:Static loc:TranslationSource.Instance}}"
                   FontSize="11" Foreground="{DynamicResource BrushTextDim}" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource BrushTextDim}"
                   Margin="0,16,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{Binding [Btn.Cancel], Source={x:Static loc:TranslationSource.Instance}}"
                    Style="{StaticResource GhostButtonStyle}" IsCancel="True"/>
            <Button x:Name="BtnCreate"
                    Content="{Binding [Btn.CreateGroup], Source={x:Static loc:TranslationSource.Instance}}"
                    Style="{StaticResource AccentButtonStyle}"
                    Margin="10,0,0,0" Click="BtnCreate_Click"/>
        </StackPanel>
    </StackPanel>
</Window>