<Window x:Class="RocketReplayUploader.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RocketReplayUploader.Infrastructure.Localization"
        Title="{Binding [Title.Settings], Source={x:Static loc:TranslationSource.Instance}}"
        Style="{StaticResource AppWindowStyle}"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/RocketReplayUploader;component/Assets/app.ico">
    <StackPanel Margin="24">
        <Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding [Title.Settings], Source={x:Static loc:TranslationSource.Instance}}"
                           FontSize="20" FontFamily="{StaticResource ManropeSemiBold}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding [Setup.SavedTo], Source={x:Static loc:TranslationSource.Instance}}"
                           FontSize="12" Foreground="{DynamicResource BrushTextDim}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding [Lang.Label], Source={x:Static loc:TranslationSource.Instance}}"
                           FontSize="12" Foreground="{DynamicResource BrushTextDim}"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="CboLanguage" Width="110" Margin="8,0,0,0" Padding="7,4" FontSize="12"
                          VerticalContentAlignment="Center"
                          SelectedValuePath="Tag"
                          SelectionChanged="CboLanguage_SelectionChanged">
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="Español" Tag="es"/>
                    <ComboBoxItem Content="Français" Tag="fr"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding [Setup.FoldersLabel], Source={x:Static loc:TranslationSource.Instance}}"
                   Margin="0,20,0,8"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [Setup.FolderHeader], Source={x:Static loc:TranslationSource.Instance}}"
                       FontSize="11" Foreground="{DynamicResource BrushTextDim}"/>
            <TextBlock Grid.Column="2" Text="{Binding [Setup.PlayerHeader], Source={x:Static loc:TranslationSource.Instance}}"
                       FontSize="11" Foreground="{DynamicResource BrushTextDim}"/>
        </Grid>

        <TextBlock Text="{Binding [Setup.Steam], Source={x:Static loc:TranslationSource.Instance}}"
                   FontSize="12" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSteamPath"
                     ToolTip="{Binding [Setup.SteamPathTip], Source={x:Static loc:TranslationSource.Instance}}"/>
            <Button Grid.Column="1" Content="{Binding [Btn.Browse], Source={x:Static loc:TranslationSource.Instance}}"
                    Style="{StaticResource GhostButtonStyle}"
                    Margin="6,0,0,0" Click="BtnBrowseSteam_Click"/>
            <TextBox Grid.Column="2" x:Name="TxtSteamPlayer" Margin="6,0,0,0"
                     ToolTip="{Binding [Setup.SteamPlayerTip], Source={x:Static loc:TranslationSource.Instance}}"/>
        </Grid>

        <TextBlock Text="{Binding [Setup.Epic], Source={x:Static loc:TranslationSource.Instance}}"
                   FontSize="12" Foreground="{DynamicResource BrushTextDim}" Margin="0,12,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtEpicPath"
                     ToolTip="{Binding [Setup.EpicPathTip], Source={x:Static loc:TranslationSource.Instance}}"/>
            <Button Grid.Column="1" Content="{Binding [Btn.Browse], Source={x:Static loc:TranslationSource.Instance}}"
                    Style="{StaticResource GhostButtonStyle}"
                    Margin="6,0,0,0" Click="BtnBrowseEpic_Click"/>
            <TextBox Grid.Column="2" x:Name="TxtEpicPlayer" Margin="6,0,0,0"
                     ToolTip="{Binding [Setup.EpicPlayerTip], Source={x:Static loc:TranslationSource.Instance}}"/>
        </Grid>

        <Button Content="{Binding [Btn.DetectFolders], Source={x:Static loc:TranslationSource.Instance}}"
                Style="{StaticResource GhostButtonStyle}"
                HorizontalAlignment="Left" Margin="0,8,0,0" Click="BtnDetect_Click"
                ToolTip="{Binding [Setup.DetectTip], Source={x:Static loc:TranslationSource.Instance}}"/>

        <TextBlock Text="{Binding [Setup.ApiKeyLabel], Source={x:Static loc:TranslationSource.Instance}}"
                   Margin="0,16,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <PasswordBox x:Name="TxtKey"/>
                <!-- Al pulsar el ojo se muestra la key en claro con un TextBox
                     real (PasswordChar='\0' en WPF deja el texto invisible). -->
                <TextBox x:Name="TxtKeyVisible" Visibility="Collapsed"/>
            </Grid>
            <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                    Margin="8,0,0,0" Padding="9,5"
                    ToolTip="{Binding [Setup.ToggleKeyTip], Source={x:Static loc:TranslationSource.Instance}}"
                    Click="BtnToggleKey_Click">
                <TextBlock x:Name="TxtToggleGlyph" Text="&#xE890;"
                           FontFamily="Segoe MDL2 Assets" FontSize="13"/>
            </Button>
        </Grid>

        <TextBlock Text="{Binding [Setup.VisLabel], Source={x:Static loc:TranslationSource.Instance}}"
                   Margin="0,16,0,6"/>
        <StackPanel>
            <RadioButton x:Name="RadPublic"
                         Content="{Binding [Setup.VisPublic], Source={x:Static loc:TranslationSource.Instance}}"
                         GroupName="Vis"/>
            <RadioButton x:Name="RadUnlisted"
                         Content="{Binding [Setup.VisUnlisted], Source={x:Static loc:TranslationSource.Instance}}"
                         GroupName="Vis" Margin="0,4,0,0"/>
            <RadioButton x:Name="RadPrivate"
                         Content="{Binding [Setup.VisPrivate], Source={x:Static loc:TranslationSource.Instance}}"
                         GroupName="Vis" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBlock Text="{Binding [Setup.ManualNote], Source={x:Static loc:TranslationSource.Instance}}"
                   FontSize="11" Foreground="{DynamicResource BrushTextDim}" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <TextBlock Text="{Binding [Setup.AfterLabel], Source={x:Static loc:TranslationSource.Instance}}"
                   Margin="0,16,0,6"/>
        <ComboBox x:Name="CboAfterUpload" SelectedIndex="0">
            <ComboBoxItem Content="{Binding [Setup.AfterNone], Source={x:Static loc:TranslationSource.Instance}}"/>
            <ComboBoxItem Content="{Binding [Setup.AfterRecycle], Source={x:Static loc:TranslationSource.Instance}}"/>
            <ComboBoxItem Content="{Binding [Setup.AfterArchive], Source={x:Static loc:TranslationSource.Instance}}"/>
        </ComboBox>

        <CheckBox x:Name="ChkAutostart"
                  Content="{Binding [Setup.Autostart], Source={x:Static loc:TranslationSource.Instance}}"
                  Margin="0,16,0,0"/>

        <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource BrushTextDim}"
                   Margin="0,16,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{Binding [Btn.Cancel], Source={x:Static loc:TranslationSource.Instance}}"
                    Style="{StaticResource GhostButtonStyle}" IsCancel="True"/>
            <Button x:Name="BtnSave"
                    Content="{Binding [Btn.Save], Source={x:Static loc:TranslationSource.Instance}}"
                    Style="{StaticResource AccentButtonStyle}"
                    Margin="10,0,0,0" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</Window>