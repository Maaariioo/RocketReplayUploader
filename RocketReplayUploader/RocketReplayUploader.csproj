<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>RocketReplayUploader.Program</StartupObject>
    <AssemblyName>RocketReplayUploader</AssemblyName>
    <RootNamespace>RocketReplayUploader</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\Fonts\Manrope-Regular.ttf" />
    <Resource Include="Assets\Fonts\Manrope-Medium.ttf" />
    <Resource Include="Assets\Fonts\Manrope-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Manrope-Bold.ttf" />
    <Resource Include="Assets\Fonts\OFL.txt" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
</Project>
